# Copy this file to `.env` and fill in your keys. Never commit `.env`.
# Get a free Gemini key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Get a free Groq key here: https://console.groq.com/keys
# Both keys are used: several free models from each, in turn (see LLM_LANES).
GROQ_API_KEY=
# Optional: which free models to use, in order. When one hits its free limit
# the next is used until it resets. Default (fastest first):
# LLM_LANES=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash,groq:openai/gpt-oss-20b,gemini:gemini-2.5-flash
# Same idea for web search (models with built-in search only: Groq gpt-oss, Gemini):
# WEB_SEARCH_LANES=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,gemini:gemini-2.5-flash,gemini:gemini-3.5-flash

# Optional: lets "play X on YouTube" start the best video directly (otherwise
# it opens YouTube's search results). Free, about 100 searches a day:
# Google Cloud console -> APIs & Services -> enable "YouTube Data API v3" ->
# Credentials -> Create API key -> restrict it to YouTube Data API v3.
YOUTUBE_API_KEY=
